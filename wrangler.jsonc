{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "rockomix-partykit",
  "main": "worker.ts",
  "alias": {
    "nanoid": "./node_modules/.pnpm/nanoid@3.3.15/node_modules/nanoid/index.browser.js"
  },
  "compatibility_date": "2025-12-17",
  "durable_objects": {
    "bindings": [
      {
        "name": "PartyRoom",
        "class_name": "PartyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PartyRoom"]
    }
  ]
}
